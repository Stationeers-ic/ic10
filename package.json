{
	"name": "@stationeers-ic/ic10",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"version": "0.3.6",
	"description": "",
	"main": "./dist/ic10.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/ic10.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prepare": "husky || exit 0",
		"generate:index": "bun tools/generate-index.ts && bun run fix",
		"generate:intruction": "bun tools/generate-intruction-index.ts && bun run fix",
		"generate:device": "bun tools/generate-devices.ts && bun run fix",
		"generate:vscode": "bun tools/generate-vscode.ts && bun run fix",
		"generate:schema": "bun tools/generate-schema.ts && bun run fix",
		"generate:langs": "bun tools/generate-langs.ts && bun run fix",
		"download": "bun tools/download.ts && bun run fix",
		"download:missing": "bun tools/download.ts --missing",
		"generate": "bun run download:missing && bun run generate:device && bun run generate:intruction && bun run generate:index && bun run generate:schema && bun run generate:vscode && bun run generate:langs",
		"upgrade": "bun run download && bun run generate && bun test",
		"build": "NODE_ENV=production bun run generate  && bun test && vite build && bunx tsc -p tsconfig.node.json && bunx tsc-alias -p tsconfig.node.json",
		"build:dev": "NODE_ENV=development bun run generate  && bun test && vite build && bunx tsc -p tsconfig.node.json && bunx tsc-alias -p tsconfig.node.json",
		"prepack": "bun test && bun run build",
		"test": "bun test $ bun test --reporter=junit --reporter-outfile=./tests/reports/report.xml",
		"watch": "bun --watch test --bail",
		"lint": "bunx --bun biome lint",
		"fix": "bunx --bun biome check . --write --unsafe",
		"format": "bunx --bun biome format --write",
		"format:check": "bunx --bun biome format",
		"dev": "bun run tools/whatch.ts",
		"show": "bun test tests/ic10/complited.test.ts --todo --only"
	},
	"devDependencies": {
		"@babel/generator": "^7.29.8",
		"@babel/traverse": "^7.29.8",
		"@biomejs/biome": "2.5.7",
		"@types/babel__generator": "^7.27.0",
		"@types/babel__traverse": "^7.28.0",
		"@types/bun": "^1.3.14",
		"@types/cli-progress": "^3.11.6",
		"@types/lodash": "^4.17.25",
		"@types/node": "^26.2.0",
		"@valibot/to-json-schema": "^1.7.1",
		"axios": "^1.19.0",
		"cli-progress": "^3.12.0",
		"glob": "^13.0.6",
		"husky": "^9.1.7",
		"js-convert-case": "^4.2.0",
		"json5": "^2.2.3",
		"lodash": "^4.18.1",
		"tsc-alias": "^1.9.1",
		"vite": "^8.2.1",
		"vite-plugin-dts": "^5.0.3"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@stationeers-ic/exact-ic10-math": "^1.1.1",
		"eventemitter3": "^5.0.4",
		"i18next": "^26.3.6",
		"uuid": "^14.0.1",
		"valibot": "^1.4.2"
	}
}
