{
	"compilerOptions": {
		"outDir": "./dist/",
		"rootDir": "./src/",
		"declaration": true,
		"module": "ESNext",
		"paths": {
			"@/*": ["./src/*"],
			"@tests/*": ["./tests/*"],
			"@tools/*": ["./tools/*"]
		},
		"lib": ["ESNext", "DOM"],
		"target": "ESNext",
		"allowJs": false,
		"skipLibCheck": true,
		"strictNullChecks": false,
		"noImplicitAny": false,
		"useUnknownInCatchVariables": false,
		"moduleResolution": "bundler"
	},
	"exclude": ["dist", "tests", "tools", "node_modules", "src/Defines", "src/Devices", "src/Schemas", "vite.config.ts"]
}
